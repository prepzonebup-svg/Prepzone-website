{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "noEmit": true,
    "types": ["node", "vite/client"], "jsx": "react-jsx", "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["netlify/functions/**/*.ts", "src/**/*.ts", "src/**/*.tsx"]
}
